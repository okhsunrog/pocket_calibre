export struct BookItem {
    id: int,
    title: string,
    author: string,
    format: string,
    state: string,
    cover: image,
}

// Все размеры интерфейса задаются в миллиметрах и умножаются на `mm` —
// число логических пикселей в одном миллиметре. Его считает Rust из реального
// dpi экрана и scale_factor, поэтому вёрстка физически одинакова на любом
// устройстве, а не «доля экрана на глаз».
export global Metrics {
    in property <length> mm: 3.94px;   // дефолт под 300dpi @scale3, до замера
}

component FlatButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <length> text-size: 3mm;
    callback clicked();

    border-width: 1px;
    border-color: root.enabled ? #000000 : #999999;
    border-radius: 1 * Metrics.mm;
    background: touch.pressed ? #000000 : #ffffff;

    Text {
        text: root.label;
        color: touch.pressed ? #ffffff : (root.enabled ? #000000 : #999999);
        font-size: root.text-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    // Передаёт наружу собственную (уже переведённую) подпись: Rust использует
    // её как заголовок нативной клавиатуры, чтобы не держать второй список
    // тех же строк на своей стороне.
    callback clicked(string);

    background: touch.pressed ? #cccccc : #ffffff;

    VerticalLayout {
        padding-left: 1.5 * Metrics.mm;
        padding-right: 1.5 * Metrics.mm;
        alignment: center;
        spacing: 0.6 * Metrics.mm;

        Text {
            text: root.label;
            font-size: 2.5 * Metrics.mm;
            color: #555555;
        }

        Text {
            text: root.value;
            font-size: 3.3 * Metrics.mm;
            color: #000000;
            overflow: elide;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #aaaaaa;
    }

    touch := TouchArea {
        clicked => {
            root.clicked(root.label);
        }
    }
}

export component MainWindow inherits Window {
    in property <[BookItem]> books;
    in property <string> server;
    in property <string> status;
    in property <bool> busy;
    in property <bool> settings-open;
    in property <string> page-label;
    in property <bool> has-prev;
    in property <bool> has-next;
    in property <string> build-id;

    in property <string> cfg-server;
    in property <string> cfg-user;
    in property <string> cfg-password;
    in property <string> cfg-library;
    in property <string> cfg-download-dir;
    in property <string> cfg-formats;
    in property <string> cfg-limit;
    in property <string> cfg-language;

    // Меняется, когда кадр нужно перерисовать целиком: после нативной
    // клавиатуры, которая рисует поверх нашего кадра, и после возврата из
    // фона. Значение само по себе не важно — важно, что от него зависит
    // фоновый прямоугольник во всю ширину экрана, так что любое изменение
    // помечает грязной всю область, и софтварный рендерер перерисовывает всё.
    in property <int> repaint-tick;

    callback refresh();
    callback download(int);
    callback toggle-settings();
    // Второй аргумент — подпись строки настроек: она же заголовок клавиатуры.
    callback edit-field(int, string);
    // Язык не набирают на клавиатуре, а перебирают тапом: Авто → English →
    // Русский. Отдельный колбэк, чтобы не пропускать его через edit-field.
    callback cycle-language();
    callback prev-page();
    callback next-page();

    // Компилятор встраивает глифы только для латиницы, цифр и строковых
    // литералов, найденных в этом файле. Кириллица нужна независимо от языка
    // интерфейса: названия книг приходят с сервера, а русские статусы и
    // строки из lang/ru рендерит Rust. Поэтому алфавит перечислен здесь явно —
    // иначе на экране будут дыры.
    // Свойство публичное намеренно: у экспортируемого компонента такие
    // свойства не вычищаются оптимизатором.
    in property <string> glyph-set: "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюяІіЇїЄєҐґЎў«»„“”—–…•№±§°←→ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖØÙÚÛÜÝÞßàáâãäåæçèéêëìíîïðñòóôõöøùúûüýþÿĀāĆćČčĐđĘęĞğŁłŃńŇňŐőŒœŘřŚśŞşŠšŤťŰűŸŹźŻżŽž";

    // Высота строки списка — она же основа для числа строк на странице.
    // 11 мм ≈ комфортная цель для тапа пальцем на e-ink.
    property <length> row-height: 11 * Metrics.mm;

    // Сколько строк влезает на страницу — это же число Rust читает, чтобы
    // нарезать список.
    out property <int> rows-per-page: max(1, floor(body.height / root.row-height));

    title: "pocket_calibre";

    // Оттенок меняется на единицу из 255 — на e-ink это неотличимо от белого,
    // но достаточно, чтобы рендерер счёл область изменившейся.
    background: mod(root.repaint-tick, 2) == 0 ? #ffffff : #fefefe;

    forward-focus: keys;

    keys := FocusScope {
        // Аппаратные кнопки листания inkview-slint отдаёт как стрелки.
        key-pressed(event) => {
            if (root.settings-open) {
                return reject;
            }
            if (event.text == Key.LeftArrow || event.text == Key.PageUp) {
                root.prev-page();
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.PageDown) {
                root.next-page();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 2 * Metrics.mm;
            spacing: 1.5 * Metrics.mm;

            HorizontalLayout {
                spacing: 2 * Metrics.mm;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: "pocket_calibre";
                        font-size: 4 * Metrics.mm;
                        font-weight: 700;
                        color: #000000;
                    }

                    Text {
                        text: root.server;
                        font-size: 2.4 * Metrics.mm;
                        color: #555555;
                        overflow: elide;
                    }
                }

                FlatButton {
                    height: 10 * Metrics.mm;
                    min-width: 20 * Metrics.mm;
                    text-size: 3 * Metrics.mm;
                    label: root.busy ? @tr("Wait…") : @tr("Refresh");
                    enabled: !root.busy && !root.settings-open;
                    clicked => {
                        root.refresh();
                    }
                }

                FlatButton {
                    height: 10 * Metrics.mm;
                    min-width: 20 * Metrics.mm;
                    text-size: 3 * Metrics.mm;
                    label: root.settings-open ? @tr("Done") : @tr("Settings");
                    clicked => {
                        root.toggle-settings();
                    }
                }
            }

            Rectangle {
                height: 2px;
                background: #000000;
            }

            // Область под содержимое. Ничего не прокручивается: и список книг,
            // и настройки нарезаются на страницы в Rust, потому что на e-ink
            // каждый кадр стоит полного обновления экрана.
            body := Rectangle {
                vertical-stretch: 1;

                if root.settings-open: VerticalLayout {
                    alignment: start;

                    SettingRow {
                        height: root.row-height;
                        label: @tr("Server address");
                        value: root.cfg-server;
                        clicked(label) => {
                            root.edit-field(0, label);
                        }
                    }

                    SettingRow {
                        height: root.row-height;
                        label: @tr("Login");
                        value: root.cfg-user;
                        clicked(label) => {
                            root.edit-field(1, label);
                        }
                    }

                    SettingRow {
                        height: root.row-height;
                        label: @tr("Password");
                        value: root.cfg-password;
                        clicked(label) => {
                            root.edit-field(2, label);
                        }
                    }

                    SettingRow {
                        height: root.row-height;
                        label: @tr("Library");
                        value: root.cfg-library;
                        clicked(label) => {
                            root.edit-field(3, label);
                        }
                    }

                    SettingRow {
                        height: root.row-height;
                        label: @tr("Download folder");
                        value: root.cfg-download-dir;
                        clicked(label) => {
                            root.edit-field(4, label);
                        }
                    }

                    SettingRow {
                        height: root.row-height;
                        label: @tr("Formats");
                        value: root.cfg-formats;
                        clicked(label) => {
                            root.edit-field(5, label);
                        }
                    }

                    SettingRow {
                        height: root.row-height;
                        label: @tr("Books to show");
                        value: root.cfg-limit;
                        clicked(label) => {
                            root.edit-field(6, label);
                        }
                    }

                    SettingRow {
                        height: root.row-height;
                        label: @tr("Language");
                        value: root.cfg-language;
                        clicked => {
                            root.cycle-language();
                        }
                    }
                }

                if !root.settings-open: VerticalLayout {
                    alignment: start;

                    for book in root.books: Rectangle {
                        height: root.row-height;
                        background: row.pressed ? #cccccc : #ffffff;

                        HorizontalLayout {
                            padding-left: 1 * Metrics.mm;
                            padding-right: 1 * Metrics.mm;
                            spacing: 2 * Metrics.mm;

                            Image {
                                width: root.row-height * 0.66;
                                source: book.cover;
                                image-fit: contain;
                            }

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 0.5 * Metrics.mm;

                                Text {
                                    text: book.title;
                                    font-size: 3.3 * Metrics.mm;
                                    color: #000000;
                                    overflow: elide;
                                }

                                Text {
                                    text: book.author;
                                    font-size: 2.7 * Metrics.mm;
                                    color: #444444;
                                    overflow: elide;
                                }
                            }

                            Text {
                                width: 20 * Metrics.mm;
                                text: book.state == "" ? book.format : book.state;
                                font-size: 2.6 * Metrics.mm;
                                color: #000000;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: #aaaaaa;
                        }

                        row := TouchArea {
                            clicked => {
                                root.download(book.id);
                            }
                        }
                    }
                }
            }

            if !root.settings-open: HorizontalLayout {
                spacing: 2 * Metrics.mm;

                FlatButton {
                    height: 10 * Metrics.mm;
                    width: 18 * Metrics.mm;
                    text-size: 4 * Metrics.mm;
                    label: "←";
                    enabled: root.has-prev;
                    clicked => {
                        root.prev-page();
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.page-label;
                    font-size: 2.9 * Metrics.mm;
                    color: #000000;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                FlatButton {
                    height: 10 * Metrics.mm;
                    width: 18 * Metrics.mm;
                    text-size: 4 * Metrics.mm;
                    label: "→";
                    enabled: root.has-next;
                    clicked => {
                        root.next-page();
                    }
                }
            }

            Rectangle {
                height: 2px;
                background: #000000;
            }

            HorizontalLayout {
                spacing: 2 * Metrics.mm;

                Text {
                    horizontal-stretch: 1;
                    text: root.status;
                    font-size: 2.6 * Metrics.mm;
                    color: #000000;
                    overflow: elide;
                }

                Text {
                    text: root.build-id;
                    font-size: 2.6 * Metrics.mm;
                    color: #888888;
                }
            }
        }
    }
}
